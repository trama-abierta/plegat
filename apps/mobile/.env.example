# Development API origin reachable from the emulator/device.
# Android emulator: http://10.0.2.2:3000
# Physical device: use the host machine's LAN address.
PLEGAT_API_ORIGIN=http://10.0.2.2:3000
PLEGAT_WEB_ORIGIN=http://10.0.2.2:5173
PLEGAT_OAUTH_CLIENT_ID=plegat-mobile
PLEGAT_OAUTH_REDIRECT_URI=plegat://oauth/callback
