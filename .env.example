# Desarrollo local HTTP. Para producción: plegat.example.com
SITE_ADDRESS=http://localhost
PUBLIC_ORIGIN=http://localhost
FRONTEND_ORIGIN=http://127.0.0.1:5173
HTTP_PORT=80
HTTPS_PORT=443
RELEASE_TAG=dev
POSTGRES_DB=plegat
POSTGRES_USER=plegat_owner
APP_DB_USER=plegat_app
# Crear estos archivos fuera del repositorio antes del despliegue.
DB_OWNER_PASSWORD_PATH=/etc/plegat/secrets/db-owner-password
DB_APP_PASSWORD_PATH=/etc/plegat/secrets/db-app-password
SESSION_SECRET_PATH=/etc/plegat/secrets/session-secret
# Seguridad del login: 5 fallos por email/IP cada 15 minutos.
LOGIN_RATE_MAX_FAILURES=5
LOGIN_RATE_WINDOW_MS=900000
