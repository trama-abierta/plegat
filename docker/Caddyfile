{$SITE_ADDRESS} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @api path /api /api/*
    handle @api {
        header Cache-Control "no-store"
        reverse_proxy backend:3000
    }
    handle {
        reverse_proxy frontend:8080
    }
}
