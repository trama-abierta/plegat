{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "name": "plegat",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @plegat/backend\" \"npm run dev -w @plegat/frontend\"",
    "build": "npm run build -w @plegat/frontend",
    "start": "npm start -w @plegat/backend",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "db:migrate": "npm run db:migrate -w @plegat/backend",
    "db:studio": "npm run db:studio -w @plegat/backend",
    "tauri": "npm --workspace @plegat/desktop run tauri --",
    "setup:local": "node scripts/setup-local.js",
    "predev": "npm run setup:local",
    "test:ui": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^9.0.0",
    "eslint": "^10.10.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "yarn": "^1.22.22"
  }
}
